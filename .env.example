# Supabase (Postgres + Auth + Storage) — see docs/ARCHITECTURE.md section 2
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=

# Demo mode (see docs/DECISIONS.md) — "true" or "1" turns it on. When a live
# read hits a schema the pending generated_sections/fact_events migrations
# haven't applied yet (Postgres 42703/42P01), the app falls back to fixture
# data through the same interfaces instead of erroring, visibly flagged in
# the UI. Off (unset/"false") means every read is real, unmasked, no
# fallback — the production default. Edge functions read the unprefixed
# DEMO_MODE (set as a Supabase secret); this only covers the client.
VITE_DEMO_MODE=
