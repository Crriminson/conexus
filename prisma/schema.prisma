// Conexus IPO Compliance Platform — Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ProjectRole {
  APPLICANT_COMPANY
  MERCHANT_BANKER
  CHARTERED_ACCOUNTANT
  COMPANY_SECRETARY
  LEGAL_ADVISOR
  UNDERWRITER
}

enum MemberStatus {
  INVITED
  ACTIVE
}

enum SectionCategory {
  COMPANY_PROFILE
  FINANCIAL
  LEGAL_RISK
  SECRETARIAL_COMPLIANCE
  BUSINESS_OFFER
}

enum SectionStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum ValidationSource {
  GAP_DETECTION
  VALIDATION_ENGINE
}

enum ValidationStatus {
  PASS
  FAIL
  FLAGGED_FOR_REVIEW
}

// Preserved from old schema
enum DocumentStatus {
  Draft
  Uploaded
  Validated
  Approved
  Rejected
}

enum GapSeverity {
  Low
  Medium
  High
  Critical
}

enum ExportFormat {
  PDF
  DOCX
  XLSX
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  avatarUrl     String?         // preserved
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt // preserved
  memberships   ProjectMember[]
  notifications Notification[]
}

model Project {
  id             String               @id @default(cuid())
  name           String
  companyName    String               // preserved
  description    String?              // preserved
  ownerId        String
  status         String               @default("active")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt // preserved
  members        ProjectMember[]
  companyProfile CompanyProfile?
  documents      Document[]
  sections       DRHPSection[]
  knowledgeBase  KnowledgeBaseEntry[]
  gapFlags       GapFlag[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  exportArtifacts ExportArtifact[]    // preserved
}

model ProjectMember {
  id        String       @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  status    MemberStatus @default(INVITED)
  invitedAt DateTime     @default(now())
  joinedAt  DateTime?
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
}

model CompanyProfile {
  id                String   @id @default(cuid())
  projectId         String   @unique
  companyName       String
  cin               String
  incorporationDate DateTime
  registeredOffice  String
  sector            String
  promoters         Json
  capitalStructure  Json
  pan               String
  gstin             String?
  fiscalYearEnd     String
  website           String?
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id           String         @id @default(cuid())
  title        String         // preserved
  projectId    String
  uploadedById String
  fileUrl      String
  fileType     String
  mimeType     String?        // preserved
  sizeBytes    Int?           // preserved
  category     String
  status       DocumentStatus @default(Draft) // preserved
  ocrStatus    String         @default("pending")
  ocrExtracted Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt // preserved
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseEntry {
  id          String   @id @default(cuid())
  projectId   String
  sourceType  String   // company_profile | ocr | interview | manual
  sourceRefId String?
  fieldKey    String
  fieldValue  String
  confidence  Float?
  category    String?  // preserved from old schema so it doesn't break knowledge-base.tsx
  content     String?  // preserved from old schema so it doesn't break knowledge-base.tsx
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DRHPSection {
  id                   String               @id @default(cuid())
  title                String               // preserved
  sectionOrder         Int                  // preserved
  projectId            String
  sectionKey           String
  category             SectionCategory
  content              String
  status               SectionStatus        @default(DRAFT)
  assignedReviewerRole ProjectRole?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions             DRHPSectionVersion[]
  validationResults    ValidationResult[]
  gapFlags             GapFlag[]            // preserved

  @@unique([projectId, sectionKey])
}

model DRHPSectionVersion {
  id          String        @id @default(cuid())
  sectionId   String
  content     String
  status      SectionStatus
  createdById String
  reviewRound Int
  reviewerId  String?
  reviewNotes String?
  createdAt   DateTime      @default(now())
  section     DRHPSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model ValidationResult {
  id                String            @id @default(cuid())
  sectionId         String?           // target made it String, old had String? I'll keep it as String? for safety? No, target is String, but relation was optional. Let's make it String? to preserve `SetNull`.
  source            ValidationSource
  status            ValidationStatus
  confidenceScore   Float?
  matchedRegulation String?
  explanation       String?
  rule              String?           // preserved
  passed            Boolean?          // preserved
  message           String?           // preserved
  createdAt         DateTime          @default(now())
  section           DRHPSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull) // preserved
}

model GapFlag {
  id          String      @id @default(cuid())
  projectId   String
  sectionKey  String
  missingItem String
  status      String      @default("open")
  title       String?     // preserved
  description String?     // preserved
  severity    GapSeverity @default(Medium) // preserved
  resolved    Boolean     @default(false)  // preserved
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt       // preserved
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId   String?     // preserved
  section     DRHPSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull) // preserved
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  type            String
  message         String
  relatedEntityId String?
  readStatus      Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Phase 2 — model only, not wired up yet
model BlockchainRecord {
  id               String   @id @default(cuid())
  sectionVersionId String?
  documentHash     String
  txHash           String
  chain            String
  blockNumber      Int?
  status           String
  createdAt        DateTime @default(now())
}

model ExportArtifact {
  id        String       @id @default(cuid())
  title     String
  format    ExportFormat
  fileUrl   String
  createdAt DateTime     @default(now())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
