generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notifications Notification[]
  memberships   ProjectMember[]
}

model Project {
  id              String                 @id @default(cuid())
  name            String
  companyName     String
  description     String?
  ownerId         String
  status          String                 @default("active")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  auditLogs       AuditLog[]
  companyProfile  CompanyProfile?
  sections        DRHPSection[]
  documents       Document[]
  eligibility     EligibilityAssessment?
  exportArtifacts ExportArtifact[]
  gapFlags        GapFlag[]
  knowledgeBase   KnowledgeBaseEntry[]
  notifications   Notification[]
  members         ProjectMember[]
}

model ProjectMember {
  id          String       @id @default(cuid())
  projectId   String
  userId      String?
  inviteEmail String?
  role        ProjectRole
  status      MemberStatus @default(INVITED)
  invitedAt   DateTime     @default(now())
  joinedAt    DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id                String   @id @default(cuid())
  projectId         String   @unique
  companyName       String
  cin               String
  incorporationDate DateTime
  registeredOffice  String
  sector            String
  promoters         Json
  capitalStructure  Json
  pan               String
  gstin             String?
  fiscalYearEnd     String
  website           String?
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EligibilityAssessment {
  id        String   @id @default(cuid())
  projectId String   @unique
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id           String         @id @default(cuid())
  title        String
  projectId    String
  uploadedById String
  fileUrl      String
  fileType     String
  mimeType     String?
  sizeBytes    Int?
  category     String
  status       DocumentStatus @default(Draft)
  ocrStatus    String         @default("pending")
  ocrExtracted Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseEntry {
  id          String   @id @default(cuid())
  projectId   String
  sourceType  String
  sourceRefId String?
  fieldKey    String
  fieldValue  String
  confidence  Float?
  category    String?
  content     String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DRHPSection {
  id                   String               @id @default(cuid())
  title                String
  sectionOrder         Int
  projectId            String
  sectionKey           String
  category             SectionCategory
  content              String
  status               SectionStatus        @default(DRAFT)
  assignedReviewerRole ProjectRole?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions             DRHPSectionVersion[]
  gapFlags             GapFlag[]
  validationResults    ValidationResult[]

  @@unique([projectId, sectionKey])
}

model DRHPSectionVersion {
  id          String        @id @default(cuid())
  sectionId   String
  content     String
  status      SectionStatus
  createdById String
  reviewRound Int
  reviewerId  String?
  reviewNotes String?
  createdAt   DateTime      @default(now())
  section     DRHPSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model ValidationResult {
  id                String           @id @default(cuid())
  sectionId         String?
  source            ValidationSource
  status            ValidationStatus
  confidenceScore   Float?
  matchedRegulation String?
  explanation       String?
  rule              String?
  passed            Boolean?
  message           String?
  createdAt         DateTime         @default(now())
  section           DRHPSection?     @relation(fields: [sectionId], references: [id])
}

model GapFlag {
  id          String       @id @default(cuid())
  projectId   String
  sectionKey  String
  missingItem String
  status      String       @default("open")
  title       String?
  description String?
  severity    GapSeverity  @default(Medium)
  resolved    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sectionId   String?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     DRHPSection? @relation(fields: [sectionId], references: [id])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  type            String
  message         String
  relatedEntityId String?
  readStatus      Boolean  @default(false)
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BlockchainRecord {
  id               String   @id @default(cuid())
  sectionVersionId String?
  documentHash     String
  txHash           String
  chain            String
  blockNumber      Int?
  status           String
  createdAt        DateTime @default(now())
}

model ExportArtifact {
  id        String       @id @default(cuid())
  title     String
  format    ExportFormat
  fileUrl   String
  createdAt DateTime     @default(now())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PendingInvite {
  id        String      @id @default(cuid())
  email     String
  projectId String
  role      ProjectRole
  status    String      @default("QUEUED")
  createdAt DateTime    @default(now())
}

model ICDRCorpus {
  id               String                 @id @default(cuid())
  regulationNumber String
  subClause        String?
  title            String
  content          String
  embedding        Unsupported("vector")?
}

enum ProjectRole {
  APPLICANT_COMPANY
  MERCHANT_BANKER
  CHARTERED_ACCOUNTANT
  COMPANY_SECRETARY
  LEGAL_ADVISOR
  UNDERWRITER
}

enum MemberStatus {
  INVITED
  ACTIVE
}

enum SectionCategory {
  COMPANY_PROFILE
  FINANCIAL
  LEGAL_RISK
  SECRETARIAL_COMPLIANCE
  BUSINESS_OFFER
}

enum SectionStatus {
  DRAFT
  SUBMITTED_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum ValidationSource {
  GAP_DETECTION
  VALIDATION_ENGINE
}

enum ValidationStatus {
  PASS
  FAIL
  FLAGGED_FOR_REVIEW
}

enum DocumentStatus {
  Draft
  Uploaded
  Validated
  Approved
  Rejected
}

enum GapSeverity {
  Low
  Medium
  High
  Critical
}

enum ExportFormat {
  PDF
  DOCX
  XLSX
}
